// TinyGBA pins for the Tang Console 138K.
// SPDX-License-Identifier: GPL-3.0-only
//
// Taken from GBATang's src/boards/console138k.cst (nand2mario), the file its own
// console138k build uses.  Every pin assignment is upstream's and none was
// invented or moved.  Unlike SNESTang's board file this one leaves USB HID and
// the DualShock pads in the build, because that is the configuration GBATang
// ships for this board; the pads also reach the core over the BL616 link.
//
// The blocks upstream leaves commented out -- MicroSD, SPI flash, s0/s1/s2 and
// the pmod1 LED bank -- stay commented out.
//
// Clock placement, copied from TinySNES's tinysnes.cst, which took it from
// TinyNES's ae350_soc.cst and TinyTang's desktop.cst, all three of which run
// HDMI on this board.  The serial-clock PLL sits at PLL_R[3] beside the TMDS
// pins with its 27 MHz reference at PLL_R[1], and the pixel-clock divider goes
// in the right side's HCLK block (block 1, lane 0); left to the placer it lands
// in block 0, from where the pixel clock does not route to the OSER10s.
// pll_27 (50 MHz -> 27 MHz) is the 27 MHz reference, so it takes PLL_R[1].
// pll_33 (16.75 / 50.25 / 67 MHz) takes PLL_R[0] and pll_12 (USB) PLL_R[2],
// which are the two remaining sites TinySNES left free; those two are this
// project's choice, not an inherited one.
INS_LOC "pll27.PLL_inst" PLL_R[1];
INS_LOC "pll33.PLL_inst" PLL_R[0];
// pll12 is not built: USB HID is disabled in src/boards/console138k.v, so
// there is no 12 MHz domain and PLL_R[2] stays free for the placer.
INS_LOC "pll_hdmi.PLL_inst" PLL_R[3];
// pll16 carries the GBA main clock.  This placement is load-bearing: a PLL
// output reaches the clock spine only through a clock-plane wire, and only
// CLKOUT0 has a pip to one on this device.  PLL_L[0]'s CLKOUT0 owns
// TLPLL0CLK0; PLL_R[0]'s is already taken by clk50.  Do not move it to a site
// whose only plane wire is in use, and do not move clk16 back to CLKOUT1.
// The left-side site costs nothing else here: no pin depends on it.
INS_LOC "pll16.PLL_inst" PLL_L[0];
INS_LOC "div5" RIGHTSIDE[4];

IO_LOC "sysclk" V22;
IO_PORT "sysclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF;

// s0 and s1 are unused in gbatang_top.sv but are top-level ports, and nextpnr
// refuses to place an unconstrained port, so they are constrained here with the
// pins GBATang's own commented-out lines name.  I/O standard: upstream's comment
// says LVCMOS15 at 1.5 V, while TinySNES's file -- which has run on this board --
// gives the same pin as LVCMOS33 at 3.3 V.  The two disagree and neither is
// resolved; these are unused inputs, so 3.3 V follows the file with hardware
// evidence behind it.  Fix this if a button is ever wired to s0/s1.
IO_LOC "s0" AA13;        // active low
IO_PORT "s0" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "s1" AB13;
IO_PORT "s1" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

// IO_LOC "s0" AA13;        // active low
// IO_PORT "s0" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=1.5;
// IO_LOC "s1" AB13;       
// IO_PORT "s1" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=1.5;
// IO_LOC "s2" Y12;        
// IO_PORT "s2" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

